# Copie para o painel do provedor (Render/Railway/Fly). Nunca versione valores reais.

SPRING_PROFILES_ACTIVE=prod

# Neon: use a connection string DIRETA (sem "-pooler") convertida para JDBC
# postgresql://user:senha@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#   -> DB_URL=jdbc:postgresql://ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=5

# Gere com: openssl rand -base64 48   (mínimo 32 bytes)
JWT_SECRET=
# 12 horas
JWT_EXPIRATION=43200000

# Senha do usuário "admin" (mínimo 8 caracteres). Substitui a senha padrão da migration.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origens do front separadas por vírgula. Aceita curingas para previews da Vercel.
CORS_ALLOWED_ORIGINS=https://byfood.vercel.app,https://byfood-*.vercel.app
